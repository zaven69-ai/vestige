{
  "expo": {
    "name": "vestige",
    "slug": "vestige",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-1024.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VESTIGE utilise votre position pour afficher les lieux proches et valider vos découvertes historiques."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon-64.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VESTIGE utilise votre position pour afficher les lieux proches et valider vos découvertes historiques."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/vestige-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/brand/vestige-logo.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ],
    "scheme": "vestige",
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#020D27"
  }
}
